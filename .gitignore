# Dependencies and package-manager caches (keep lockfiles tracked)
node_modules/
.npm/
.pnpm-store/
.yarn/*
!.yarn/patches/
!.yarn/plugins/
!.yarn/releases/
!.yarn/sdks/
!.yarn/versions/
.pnp.*

# Build output and tool caches
/dist/
/dist-ssr/
/build/
.vite/
.vite-temp/
.cache/
.eslintcache
.stylelintcache
*.tsbuildinfo

# Test output
coverage/
.nyc_output/
playwright-report/
test-results/

# Logs and runtime diagnostics
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
report.*.json
*.pid
*.pid.lock
*.cpuprofile
*.heapprofile
*.heapsnapshot

# Local environment and credentials; commit only sanitized templates
.env
.env.*
!.env.example
!.env.*.example
!.env.sample
!.env.*.sample
!.env.template
!.env.*.template
*.local
.aws/
*.pem
*.key
*.p12
*.pfx

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea/
.history/
.vs/
.DS_Store
.DS_Store?
._*
.Spotlight-V100/
.Trashes/
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~
*.orig
*.rej

# Temporary files and local deployment state
/tmp/
/temp/
*.tmp
*.temp
.vercel/
.netlify/
